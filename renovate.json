{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge non-major updates once CI is green (platform automerge)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Major updates stay as PRs for human review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Group Go toolchain updates together",
      "matchDatasources": ["golang-version"],
      "groupName": "Go toolchain"
    }
  ],
  "gomod": {
    "postUpdateOptions": ["gomodTidy"]
  },
  "github-actions": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  }
}
